# ===========================================
# VARIÁVEIS DE AMBIENTE - dANI.PT
# ===========================================
# Copia este ficheiro para .env e preenche com os valores reais
# As chaves do Supabase estão em: Supabase Dashboard > Settings > API

# Frontend (React)
REACT_APP_SUPABASE_URL=https://SEU_PROJECT.supabase.co
REACT_APP_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend (Serverless Functions)
SUPABASE_URL=https://SEU_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT Secret (qualquer string aleatória para assinar tokens)
JWT_SECRET=sua-chave-secreta-aqui-minimo-32-caracteres
