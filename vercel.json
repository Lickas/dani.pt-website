{
  "version": 2,
  "framework": "create-react-app",
  "buildCommand": "yarn build",
  "outputDirectory": "build",
  "installCommand": "yarn install",
  "functions": {
    "api/**/*.py": {
      "runtime": "python3.11",
      "maxDuration": 10
    }
  },
  "routes": [
    { "src": "/api/health", "dest": "/api/health.py" },
    { "src": "/api/vehicles/(.*)", "dest": "/api/vehicles.py" },
    { "src": "/api/vehicles", "dest": "/api/vehicles.py" },
    { "src": "/api/campaigns/(.*)", "dest": "/api/campaigns.py" },
    { "src": "/api/campaigns", "dest": "/api/campaigns.py" },
    { "src": "/api/contacts/(.*)", "dest": "/api/contacts.py" },
    { "src": "/api/contacts", "dest": "/api/contacts.py" },
    { "src": "/api/upload/(.*)", "dest": "/api/upload.py" },
    { "src": "/api/admin/login", "dest": "/api/admin/login.py" },
    { "src": "/api/admin/register", "dest": "/api/admin/register.py" },
    { "src": "/api/newsletter/unsubscribe", "dest": "/api/newsletter.py" },
    { "src": "/api/newsletter/check/(.*)", "dest": "/api/newsletter.py" },
    { "src": "/api/newsletter", "dest": "/api/newsletter.py" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
